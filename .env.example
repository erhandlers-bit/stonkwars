# Copy to .env and fill in. Nothing here is required just to run the bracket.

# Solana RPC used to verify pick eligibility and (if enabled) send payouts.
RPC_URL=https://api.mainnet-beta.solana.com

# Token required on admin calls (start/pause/resume/reset). If unset, admin
# calls are only accepted from localhost.
ADMIN_TOKEN=change-me

# PAYOUTS. Only needed if STONK_PAYOUT_ENABLED is true in src/config.js.
# Use a DEDICATED wallet that holds nothing but the prize funds. Base58 secret
# (Phantom export) or a JSON byte array. Never reuse a trading wallet.
# STONK_PAYOUT_KEY=

# Optional: serve on a different port
# PORT=3737
