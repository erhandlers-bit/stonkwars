# Copy to .env and fill in. Nothing here is required just to run the bracket.

# Solana RPC used to verify pick eligibility and (if enabled) send payouts.
RPC_URL=https://api.mainnet-beta.solana.com

# Token required on admin calls (start/pause/resume/reset). If unset, admin
# calls are only accepted from localhost.
ADMIN_TOKEN=change-me

# PAYOUTS / TREASURY. Only needed when STONK_TREASURY_ENABLED (or
# STONK_PAYOUT_ENABLED) is true in src/config.js.
# Treasury mode claims pump.fun creator fees, so this MUST be the token
# creator's (dev) wallet key — the claim is signed by the creator. Base58
# secret (Phantom export) or a JSON byte array. Keep this machine clean; the
# key sits here in plaintext. Never reuse a wallet that holds more than the
# fees and the coin.
# STONK_PAYOUT_KEY=

# Optional: serve on a different port
# PORT=3737
